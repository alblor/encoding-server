# Copy to .env (gitignored) and adjust. Placeholders only: nothing secret belongs in this file,
# secrets stay in Docker secrets (./secrets, see scripts/generate_secrets.sh).

# Address the API port is published on. 127.0.0.1 keeps it reachable from this host only.
# To let other machines connect, set the address of the interface they reach, for example the
# LAN address of the LXC or VM running Docker. Do NOT use 0.0.0.0 unless a firewall is in front.
API_BIND_ADDR=127.0.0.1

# Host header values the API accepts. Add the same address clients put in the URL.
ALLOWED_HOSTS=localhost,127.0.0.1

# Restoration (optional GPU feature, compose profile "gpu"). Size of the RAM-backed volume that carries the compressed
# segments between the API and the workers. It lives in host RAM, so keep it well under what the machine can spare.
RESTORE_WORK_SIZE=8g

# Transformer precision of the GPU workers: bf16 is the reference quality, fp8 is about 1.4x faster in the transformer
# at 46.8 dB against bf16 (needs torch.compile, which the worker uses). Applies to every worker started afterwards.
RESTORE_PRECISION=bf16

# Memory the API assumes a worker has, to refuse a segment that cannot fit instead of letting a worker be OOM-killed.
# Keep them equal to the mem_limit of the restore worker services in docker-compose.secure.yml.
RESTORE_GPU_WORKER_MEMORY_MB=22528
RESTORE_CPU_WORKER_MEMORY_MB=12288

# Project name: the secret lifecycle script derives the container name from it, so keep it as is.
COMPOSE_PROJECT_NAME=encoding-server

# Where the restoration weights and the compile caches live on the host (the workers mount the first one read-only).
RESTORE_MODELS_DIR=/srv/models/recavsr
RESTORE_CACHE_DIR=/srv/cache/restore
